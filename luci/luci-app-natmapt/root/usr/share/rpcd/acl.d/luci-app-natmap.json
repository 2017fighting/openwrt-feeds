{
	"luci-app-natmap": {
		"description": "Grant access to LuCI app natmap",
		"read": {
			"file": {
				"/etc/natmap/client": [ "list" ],
				"/etc/natmap/notify": [ "list" ],
				"/etc/natmap/ddns": [ "list" ]
			},
			"ubus": {
				"luci.natmap": [ "get_congestions", "get_status", "nattest", "reload" ]
			},
			"uci": [ "natmap" ]
		},
		"write": {
			"uci": [ "natmap" ]
		}
	}
}
