#!/bin/sh /etc/rc.common
# 裸核 mihomo 的 procd 外壳（docs/adr/0017）。
#
# 与 nikki 的关键差别：这里**没有** nft 表、ip rule、cgroup 旁路、订阅 UA 之外的任何
# 中间层 —— 除了一层「回程豁免」（见 reply-bypass.nft）：tun.auto-route 不看 conntrack
# 方向，fw4 DNAT 过的入站连接（natmap/fullcone/hairpin）回程必须显式放回 main 表，
# 否则洞打得开、数据进不来（2026-11-12 夜的事故，详见 nft 文件头注释）。
# 本脚本只做：读 uci、装/拆回程豁免、护着进程、首启没配置就去取。

# shellcheck disable=SC2034  # START/STOP/USE_PROCD 由 /etc/rc.common 读取
START=99
STOP=10
USE_PROCD=1

NAME=mihomo-bare
REPLY_BYPASS_NFT=/etc/mihomo-bare/reply-bypass.nft
REPLY_BYPASS_MARK=0x99

service_triggers() {
	procd_add_reload_trigger "$NAME"
}

# 回程豁免:必须在核启动前就位(核的流量一进来就要查 ip rule)
load_reply_bypass() {
	nft -f "$REPLY_BYPASS_NFT" || {
		logger -t "$NAME" "reply-bypass nft 加载失败(入站映射的回程会被 tun 吞)"
		return 1
	}
	local f
	for f in -4 -6; do
		ip $f rule del pref 8999 2>/dev/null
		ip $f rule add pref 8999 fwmark "$REPLY_BYPASS_MARK/0xff" lookup main
	done
}

unload_reply_bypass() {
	local f
	for f in -4 -6; do
		ip $f rule del pref 8999 2>/dev/null
	done
	nft delete table inet mihomo_bare 2>/dev/null
}

start_service() {
	local enabled dir core reply_bypass
	config_load "$NAME"
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get dir main dir /etc/mihomo
	config_get core main core /usr/bin/mihomo
	config_get_bool reply_bypass main reply_bypass 1

	mkdir -p "$dir"

	# 首次开机 / 换机：没有配置就先取一份。取不到不阻塞启动流程（cron 会再来），
	# 但也不去跑一个空核 —— 让日志说清楚为什么没起。
	if [ ! -s "$dir/config.yaml" ]; then
		/usr/sbin/mihomo-bare-update || {
			logger -t "$NAME" "no $dir/config.yaml yet (fetch failed); cron will retry"
			return 0
		}
	fi

	[ "$reply_bypass" = 1 ] && load_reply_bypass

	procd_open_instance
	procd_set_param command "$core" -d "$dir"
	# 崩了就一直拉起来：这是全家的网关，停着比反复重启更糟
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="65536 65536"
	# 输出进 syslog（logd），与 nikki 的 mirror-to-syslog 同效；不落磁盘，不需要清理 cron
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# tun/路由表/nft 由核自己拆；回程豁免是我们的，跟着服务走
	sleep 1
	unload_reply_bypass
}
