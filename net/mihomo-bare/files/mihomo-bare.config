config mihomo-bare 'main'
	# 服务总开关。配置本身不在这里 —— 那份 YAML 完全由
	# mihomo-headless-worker 的 router 档案生成，本包只负责取回来跑。
	option enabled '1'
	# 工作目录：config.yaml、cache.db、ui/、providers/ 都在这里（mihomo -d）
	option dir '/etc/mihomo'
	# 核：mihomo-alpha 装在 /usr/libexec/mihomo（不建 /usr/bin 符号链接）。
	# 换核只改这一行，不必动 init 脚本
	option core '/usr/libexec/mihomo'
	# 订阅地址含 token，不进公开仓库 —— 装机时用 uci set 写：
	#   uci set mihomo-bare.main.subscription_url='https://…/y/<token>?profile=router'
	#   uci commit mihomo-bare && /usr/sbin/mihomo-bare-update
	option subscription_url ''
	# 服务端会把请求的 UA 当档案寻址的一部分记日志；保持与 nikki 时代一致
	option user_agent 'mihomo router/1.0'
	# 定时拉取的 cron 片段（uci-defaults 写进 /etc/crontabs/root）
	option update_cron '*/30 * * * *'
	# 拉取超时（秒）
	option fetch_timeout '60'
	# 回程豁免(reply-bypass.nft):ct direction reply 打 mark 走 main 表,
	# 不让 auto-route 的 ip rule 把 fw4 DNAT 过的入站连接回程吞进 tun。
	# natmap/fullcone/hairpin 依赖它;出问题排障时可临时关掉对拍
	option reply_bypass '1'
